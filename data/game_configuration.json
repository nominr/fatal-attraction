      "rebecca",
      "marcus",
      "sofia",
      "amir",
      "bella",
      "chris",
      "diana",
      "eli"
    ],
    "npcPerTurn": 3,
    "notifications": {
      "meterUpdate": "You {verb} the {meter} meter ({value}/{max}).",
      "impactNotice": "{actor} impacted {meter}: {delta} (now {value}/{max}).",
      "turnStart": "--- TURN {turn} START ---",
      "turnEnd": "--- TURN {turn} END ---"
    }
  }
