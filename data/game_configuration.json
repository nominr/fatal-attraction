{
  "game": {
    "id": "fatal_attraction",
    "version": "0.1"
  },

  "roles": {
    "admirer": {
      "displayName": "Admirer",

      "powers": {
        "kill_npc": {
          "displayName": "Kill NPCs",
          "constraints": {
            "mustBeNonConvert": true
          },
          "uiHint": "Kill button (maybe weapons later)"
        },

        "unconvert_target": {
          "displayName": "Unconvert targets",
          "resolution": {
            "type": "chance",
            "baseChance": 0.55,
            "label": "mid"
          }
        },

        "unconvert_love_interest": {
          "displayName": "Unconvert love interest",
          "resolution": {
            "type": "chance",
            "baseChance": 0.55,
            "label": "mid"
          }
        }
      },

      "goals": {
        "kill_targets": {
          "displayName": "Kill targets",
          "constraints": {
            "mustBeNonConvert": true
          }
        },
        "marry_love_interest": {
          "displayName": "Marry love interest",
          "constraints": {
            "mustBeNonConvert": true
          }
        }
      },

      "meters": {
        "love": {
          "displayName": "Love",
          "min": 0,
          "max": 10,
          "start": 0,
          "notes": "Raise by talking to interest; similar mechanic to Chaos."
        }
      }
    },

    "prophet": {
      "displayName": "Prophet",

      "powers": {
        "convert_npc": {
          "displayName": "Convert NPCs",
          "resolution": {
            "type": "rps"
          },
          "cooldown": {
            "seconds": 1,
            "scaling": "decreases_as_chaos_or_attempts_increase"
          },
          "notes": "NPCs grant immunity."
        },

        "increase_chaos": {
          "displayName": "Increase Chaos",
          "cooldown": {
            "seconds": 1
          }
        },

        "prank": {
          "displayName": "Prank any character",
          "resolution": {
            "type": "immediate"
          }
        },

        "set_trap": {
          "displayName": "Set traps",
          "resolution": {
            "type": "delayed"
          }
        }
      },

      "goals": {
        "convert_quota": {
          "displayName": "Convert a set number of people"
        },
        "chaos_threshold": {
          "displayName": "Achieve a set level of chaos to win"
        }
      },

      "meters": {
        "chaos": {
          "displayName": "Chaos",
          "min": 0,
          "max": 10,
          "start": 0,
          "segments": [
            {
              "name": "low",
              "from": 0,
              "to": 3,
              "convertAttemptsRequired": 2
            },
            {
              "name": "mid",
              "from": 3,
              "to": 7,
              "convertAttemptsRequired": 1
            },
            {
              "name": "high",
              "from": 7,
              "to": 10,
              "convertAttemptsRequired": 0
            }
          ],
          "notes": "Higher chaos makes conversion easier."
        }
      }
    },

    "producer": {
      "displayName": "Producer",

      "powers": {
        "unconvert_npc": {
          "displayName": "Unconvert NPCs",
          "resolution": {
            "type": "chance",
            "baseChance": 0.75,
            "label": "high"
          }
        },

        "marry_npc": {
          "displayName": "Marry NPCs",
          "effects": [
            {
              "meter": "ratings",
              "delta": 1
            }
          ]
        },

        "cleanup_prank": {
          "displayName": "Clean-Up Pranks",
          "effects": [
            {
              "meter": "chaos",
              "delta": -1,
              "clampMin": 0
            }
          ],
          "notes": "Decreases chaos or prevents it from rising."
        },

        "report_admirer": {
          "displayName": "Report Admirer",
          "notes": "Triggers blitz between Prophet and Producer; Admirer becomes observer."
        }
      },

      "goals": {
        "high_ratings": {
          "displayName": "Achieve high level of ratings"
        },
        "catch_admirer": {
          "displayName": "Catch Admirer",
          "type": "subgoal"
        }
      },

      "meters": {
        "ratings": {
          "displayName": "Ratings",
          "min": 0,
          "max": 10,
          "start": 0,
          "notes": "Raised through NPC marriage interactions."
        }
      }
    }
  },

  "systems": {
    "editorial_attention": {
      "displayName": "Editorial Attention",
      "focusTokensPerTurn": 1,
      "decay": true,

      "focusOptions": {
        "sudden_deaths": {
          "displayName": "Sudden NPC deaths",
          "detectionMultiplier": 2.0
        },
        "romantic_escalations": {
          "displayName": "Romantic escalations",
          "detectionMultiplier": 1.5
        },
        "chaos_spikes": {
          "displayName": "Chaos spikes",
          "detectionMultiplier": 1.5
        },
        "public_areas": {
          "displayName": "Public areas",
          "detectionMultiplier": 1.25
        }
      }
    }
  },

  "npcs": {
    "katy": {
      "id": "katy",
      "name": "Katy",
      "role": "love_interest",
      "isTarget": false,
      "convertedStatus": false,
      "married": false,
      "interactionTree": {
        "root": {
          "text": "Katy walks up to you, smiling warmly.",
          "options": [
            {
              "id": "flirt",
              "text": "Flirt romantically (Admirer, +2 love)",
              "requires": { "role": "admirer" },
              "effects": [
                { "meter": "love", "delta": 2, "clampMax": 10 },
                { "notification": "You flirted with Katy! Love increased significantly!" }
              ]
            },
            {
              "id": "unconvert",
              "text": "Attempt to unconvert (Admirer, 55% chance)",
              "requires": { "role": "admirer", "npcStatus": "converted" },
              "resolution": { "type": "chance", "successChance": 0.55 },
              "effects_on_success": [
                { "notification": "Success! Katy is unconverted." },
                { "npc": "katy", "field": "convertedStatus", "value": false }
              ],
              "effects_on_failure": [
                { "notification": "Failed to unconvert Katy." }
              ]
            },
            {
              "id": "prank_katy",
              "text": "Prank Katy (Prophet, +1 chaos)",
              "requires": { "role": "prophet" },
              "effects": [
                { "meter": "chaos", "delta": 1, "clampMax": 10 },
                { "notification": "You pranked Katy! Chaos increased." }
              ]
            },
            {
              "id": "convert_katy",
              "text": "Try to convert (Prophet, RPS)",
              "requires": { "role": "prophet" },
              "resolution": { "type": "rps" },
              "effects_on_success": [
                { "meter": "chaos", "delta": 1, "clampMax": 10 },
                { "notification": "You converted Katy!" },
                { "npc": "katy", "field": "convertedStatus", "value": true }
              ],
              "effects_on_failure": [
                { "notification": "Katy resisted your conversion." }
              ]
            },
            {
              "id": "marry",
              "text": "Marry (Producer, +1 ratings)",
              "requires": { "role": "producer", "npcMarriageable": true },
              "marry_initiate": true,
              "effects": [
                { "meter": "ratings", "delta": 1, "clampMax": 10 },
                { "notification": "You set up an NPC marriage! Ratings increased." }
              ]
            },
            {
              "id": "interview",
              "text": "Interview (Producer, +1 ratings)",
              "requires": { "role": "producer" },
              "effects": [
                { "meter": "ratings", "delta": 1, "clampMax": 10 },
                { "notification": "You interviewed Katy! Ratings increased." }
              ]
            },
            {
              "id": "leave",
              "text": "Walk away",
              "effects": []
            }
          ]
        }
      }
    },
    "john": {
      "id": "john",
      "name": "John",
      "role": "generic",
      "isTarget": true,
