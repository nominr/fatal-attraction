            {
              "id": "talk_john",
              "text": "Talk to John (Admirer, +1 love)",
              "requires": { "role": "admirer" },
              "effects": [
                { "meter": "love", "delta": 1, "clampMax": 10 },
                { "notification": "You talked with John about Katy. Love increased!" }
