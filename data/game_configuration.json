                { "npc": "john", "field": "convertedStatus", "value": true }
              ],
              "effects_on_failure": [
                { "notification": "John resisted your conversion." }
              ]
            },
            {
              "id": "prank",
              "text": "Prank John (Prophet, +1 chaos)",
              "requires": { "role": "prophet" },
              "effects": [
                { "meter": "chaos", "delta": 1, "clampMax": 10 },
                { "notification": "You pranked John! Chaos increased." }
              ]
            },
            {
              "id": "trap",
              "text": "Set trap near John (Prophet, +1 chaos)",
              "requires": { "role": "prophet" },
              "effects": [
                { "meter": "chaos", "delta": 1, "clampMax": 10 },
                { "notification": "You set a trap! Chaos increased." }
              ]
            },
            {
              "id": "unconvert_john",
              "text": "Unconvert John (Producer, 75% chance)",
              "requires": { "role": "producer", "npcStatus": "converted" },
              "resolution": { "type": "chance", "successChance": 0.75 },
              "effects_on_success": [
                { "notification": "You unconverted John!" },
                { "npc": "john", "field": "convertedStatus", "value": false }
              ],
              "effects_on_failure": [
                { "notification": "Failed to unconvert John." }
              ]
            },
            {
              "id": "cleanup_john",
              "text": "Clean up situation (Producer, -1 chaos)",
              "requires": { "role": "producer" },
              "effects": [
                { "meter": "chaos", "delta": -1, "clampMin": 0 },
                { "notification": "You cleaned up! Chaos decreased." }
              ]
            },
            {
              "id": "marry_john",
              "text": "Marry (Producer, +1 ratings)",
              "requires": { "role": "producer", "npcMarriageable": true },
              "marry_initiate": true,
              "effects": [
                { "meter": "ratings", "delta": 1, "clampMax": 10 },
                { "notification": "You set up an NPC marriage! Ratings increased." }
              ]
            },
            {
              "id": "leave",
              "text": "Walk away",
              "effects": []
            }
          ]
        }
      }
    },
