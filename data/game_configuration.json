{
  "game": {
    "id": "fatal_attraction",
    "version": "0.1"
  },
  "roles": {
    "admirer": {
      "displayName": "Admirer",
      "powers": {
        "kill_npc": {
          "displayName": "Kill NPCs",
          "constraints": {
            "mustBeNonConvert": true
          },
          "uiHint": "Kill button"
        },
        "unconvert_target": {
          "displayName": "Unconvert targets",
          "resolution": {
            "type": "chance",
            "baseChance": 0.55
          },
          "constraints": {
            "mustBeTarget": true
          }
        },
        "unconvert_love_interest": {
          "displayName": "Unconvert love interest",
          "resolution": {
            "type": "chance",
            "baseChance": 0.55
          },
          "constraints": {
            "mustBeLoveInterest": true
          }
        }
      },
      "goals": {
        "kill_targets": {
          "displayName": "Kill targets (non-converts)",
          "constraints": {
            "mustBeNonConvert": true
          }
        },
        "marry_love_interest": {
          "displayName": "Marry love interest (non-convert)",
          "constraints": {
            "mustBeNonConvert": true
          }
        }
      },
      "meters": {
        "love": {
          "displayName": "Love",
          "min": 0,
          "max": 10,
          "start": 0,
          "notes": "Raise by talking to interest"
        }
      }
    },
    "prophet": {
      "displayName": "Prophet",
      "powers": {
        "convert_npc": {
          "displayName": "Convert NPCs",
          "resolution": {
            "type": "rps"
          },
          "constraints": {
            "coolOff": true
          }
        },
        "increase_chaos": {
          "displayName": "Increase Chaos",
          "constraints": {
            "coolOff": true
          }
        },
        "prank": {
          "displayName": "Prank Character",
          "resolution": {
            "type": "immediate"
          }
        },
        "set_trap": {
          "displayName": "Set Trap",
          "resolution": {
            "type": "delayed"
          }
        }
      },
      "goals": {
        "convert_quota": {
          "displayName": "Convert a set number of people"
        },
        "chaos_threshold": {
          "displayName": "Achieve high chaos"
        }
      },
      "meters": {
        "chaos": {
          "displayName": "Chaos",
          "min": 0,
          "max": 10,
          "start": 0,
          "segments": [
            {
              "name": "hard",
              "from": 0,
              "to": 3
            },
            {
              "name": "normal",
              "from": 3,
              "to": 7
            },
            {
              "name": "easy",
              "from": 7,
              "to": 10
            }
          ]
