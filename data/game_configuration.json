  "gameRules": {
    "turnsPerGame": 15,
    "maxPlayers": 3,
    "npcsPerTurn": 3,
    "winConditions": {
      "admirer": {
        "primary": { "goal": "marry_love_interest", "requirement": { "meter": "love", "minValue": 8, "npcStatus": "nonConverted" } },
        "secondary": { "goal": "kill_targets", "requirement": { "npcsKilled": 3 } }
      },
      "prophet": {
        "primary": { "goal": "chaos_threshold", "requirement": { "meter": "chaos", "minValue": 9 } },
        "secondary": { "goal": "convert_quota", "requirement": { "npcsConverted": 4 } }
      },
      "producer": {
        "primary": { "goal": "high_ratings", "requirement": { "meter": "ratings", "minValue": 8 } },
        "secondary": { "goal": "catch_admirer", "requirement": { "admirerReported": true } }
      }
    }
  },

  "demoClient": {
    "mode": "turn_based_text",
    "input": "single_keyboard",
    "autoNextTurn": true,
    "npcPool": ["katy", "john", "rebecca", "marcus", "sofia"],
    "npcPerTurn": 3,

    "notifications": {
      "meterUpdate": "You {verb} the {meter} meter ({value}/{max}).",
      "impactNotice": "{actor} impacted {meter}: {delta} (now {value}/{max}).",
      "turnStart": "--- TURN {turn} START ---",
      "turnEnd": "--- TURN {turn} END ---"
    }
  }
}
