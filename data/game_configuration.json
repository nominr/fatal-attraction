  "npcs": {
    "katy": {
      "id": "katy",
      "name": "Katy",
      "role": "love_interest",
      "isTarget": false,
      "convertedStatus": false,
      "married": false,
      "interactionTree": {
        "root": {
          "text": "Katy walks up to you, smiling warmly.",
          "options": [
            {
              "id": "flirt",
              "text": "Flirt romantically (Admirer, +2 love)",
              "requires": {
                "role": "admirer"
              },
              "effects": [
                {
                  "meter": "love",
                  "delta": 2,
                  "clampMax": 10
                },
                {
                  "notification": "You flirted with Katy! Love increased significantly!"
                }
              ]
            },
            {
              "id": "marry",
              "text": "Marry Katy (Requires Rivals Dead, Chance based on Love)",
              "requires": {
                "role": "admirer",
                "npcStatus": "nonConverted"
              },
              "marry_admirer_love": true,
              "effects": [
                {
                  "notification": "You proposed to Katy! Love story achieved!"
                },
                {
                  "npc": "katy",
                  "field": "married",
                  "value": true
                }
              ]
            },
            {
              "id": "unconvert",
              "text": "Attempt to unconvert (Admirer, 30% chance)",
              "requires": {
                "role": "admirer",
                "npcStatus": "converted"
              },
              "resolution": {
                "type": "chance",
                "successChance": 0.30
              },
              "effects_on_success": [
                {
                  "notification": "Success! Katy is unconverted."
                },
                {
                  "npc": "katy",
                  "field": "convertedStatus",
                  "value": false
                }
              ],
              "effects_on_failure": [
                {
                  "notification": "Failed to unconvert Katy."
                }
              ]
            },
            {
              "id": "prank_katy",
              "text": "Prank Katy (Prophet, +1 chaos)",
              "requires": {
                "role": "prophet"
              },
              "effects": [
                {
                  "meter": "chaos",
                  "delta": 1,
                  "clampMax": 10
                },
                {
                  "notification": "You pranked Katy! Chaos increased."
                },
                {
                  "npc": "katy",
