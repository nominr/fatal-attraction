  "gameRules": {
    "turnsPerGame": 15,
    "maxPlayers": 3,
    "npcsPerTurn": 3,
    "winConditions": {
      "admirer": {
        "primary": {
          "goal": "eliminate_targets",
          "requirement": {
            "npcsKilled": 3
          }
        }
      },
      "prophet": {
        "primary": {
          "goal": "chaos_and_converts",
          "requirement": {
            "meter": "chaos",
            "minValue": 10,
            "npcsConverted": 5
          }
        },
        "secondary": {
          "goal": "convert_quota",
          "requirement": {
            "npcsConverted": 5
          }
        }
      },
      "producer": {
        "primary": {
          "goal": "high_ratings",
          "requirement": {
            "meter": "ratings",
            "minValue": 10
          }
        },
        "secondary": {
          "goal": "catch_admirer",
          "requirement": {
            "admirerReported": true
          }
        }
      }
    }
  },
  "demoClient": {
    "mode": "turn_based_text",
    "input": "single_keyboard",
    "autoNextTurn": true,
    "npcPool": [
      "katy",
