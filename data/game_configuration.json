    "katy": {
      "id": "katy",
      "name": "Katy",
      "role": "generic",
      "isTarget": false,
      "convertedStatus": false,
      "married": false,
      "interactionTree": {
        "root": {
          "text": "Katy walks up to you, smiling warmly.",
          "options": [
            {
              "id": "start_flirt",
              "text": "Flirt with Katy",
              "requires": {
                "role": "admirer"
              },
              "effects": []
            },
            {
              "id": "convert_katy",
              "text": "Try to convert Katy",
              "requires": {
                "role": "prophet",
                "npcStatus": "nonConverted"
              },
              "resolution": {
                "type": "rps"
              },
              "effects_on_success": [
                {
                  "meter": "chaos",
                  "delta": 1,
                  "clampMax": 10
                },
                {
                  "notification": "You converted Katy!"
                },
                {
                  "npc": "katy",
                  "field": "convertedStatus",
                  "value": true
                }
              ],
              "effects_on_failure": [
                {
                  "notification": "Katy resisted your conversion."
                }
              ]
            }
          ]
        }
      }
